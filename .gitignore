# Compiled binaries. Anchored to the repository root so they do not also match
# the cmd/relay and cmd/exit source directories.
/bin/
/relay
/exit
/max301-client.exe
*.exe
*.dll

# Real configuration holds the shared password; only examples belong in git.
*.yaml
!configs/*.yaml.example
client.yaml
relay.yaml
exit.yaml

# Domestic prefix list, fetched at deploy time. The copy under internal/router
# is embedded into the binary and must stay tracked, or the build breaks.
/chnroute.txt
china_ip_list.txt

# Logs
*.log

# Go
vendor/
*.test
*.out

# Release artefacts, uploaded to GitHub rather than committed.
/dist/
